  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <!-- Tabler Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css"/>
  <style>
    :root {
      --milk: #F8F5F0;
      --accent: #9B7964;
      --deep: #40352F;
    }
    html {
      scroll-behavior: smooth;
      background: var(--milk);
    }
    body {
      font-family: 'Inter', Arial, sans-serif;
      color: var(--deep);
      background: var(--milk);
    }
    h1,h2,h3,h4 {
      font-family: 'Playfair Display', serif;
      letter-spacing: -0.01em;
    }
    .fadeup {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.8s cubic-bezier(.95,.25,.25,1), transform 0.8s cubic-bezier(.95,.25,.25,1);
    }
    .fadeup.visible {
      opacity: 1;
      transform: none;
    }
    .custom-shadow {
      box-shadow: 0 4px 24px 0 rgba(155,121,100,0.07), 0 1.5px 8px 0 rgba(64,53,47,0.045);
    }
    .card-hover:hover, .btn-accent:hover {
      filter: brightness(0.98);
      box-shadow: 0 6px 24px 0 rgba(155,121,100,0.09);
      transition: box-shadow .2s, filter .2s;
    }
    .icon-star {
      color: #FFC560;
      margin-right: 2px;
    }
    /* scrollbar minimalist */
    ::-webkit-scrollbar { width: 8px; background: #F2EAE1; }
    ::-webkit-scrollbar-thumb { background: #E2D5C3; border-radius: 6px; }
  </style>
</head>
