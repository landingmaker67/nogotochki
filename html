  <!-- JS: анимации, навигация, онлайн-запись, интерактив -->
  <script>
    // Мобильное меню
    const openNav = document.getElementById('openNav');
    const mobileNav = document.getElementById('mobileNav');
    const closeNav = () => mobileNav.style.transform = "translateX(100%)";
    openNav.onclick = () => mobileNav.style.transform = "translateX(0)";
    [...mobileNav.querySelectorAll('a,button')].forEach(el => el.onclick = closeNav);

    // Плавный скролл (для iOS и Edge fix)
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.onclick = function(e) {
        const id = this.getAttribute('href').substring(1);
        const section = document.getElementById(id);
        if(section){
          e.preventDefault();
          window.scrollTo({
            top: section.offsetTop - 80,
            behavior: 'smooth'
          });
        }
      }
    });

    // Анимация появления блоков
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if(entry.isIntersecting) entry.target.classList.add('visible');
      })
    }, { threshold: 0.08 });
    document.querySelectorAll('.fadeup').forEach(el => observer.observe(el));

    // --- Онлайн-запись ---
    // Элементы
    const bookingModal = document.getElementById('bookingModal');
    const openBooking = document.getElementById('openBooking');
    const openBookingMain = document.getElementById('openBookingMain');
    const openBooking2 = document.getElementById('openBooking2');
    const closeBookingBtn = document.getElementById('closeBooking');
    const bookingForm = document.getElementById('bookingForm');
    const bookingSuccess = document.getElementById('bookingSuccess');
    const bookingError = document.getElementById('bookingError');
    const timeSlotsDiv = document.getElementById('timeSlots');
    const serviceSelect = document.getElementById('serviceSelect');
    const dateInput = document.getElementById('dateInput');
    let selectedTime = "";
    let bookedTimes = []; // [{date: 'YYYY-MM-DD', time: '10:00'}, ...]
    const TIME_SLOTS = ["10:00", "11:30", "13:00", "14:30", "16:00", "17:30"];
    // min date: today
    const today = new Date();
    dateInput.min = today.toISOString().split('T')[0];
    // Хранилище записей
    function loadBookings() {
      bookedTimes = JSON.parse(localStorage.getItem('beauty_bookings')||"[]");
    }
    function storeBookings() {
      localStorage.setItem('beauty_bookings', JSON.stringify(bookedTimes));
    }
    // Открытие и закрытие модали
    function openBookingModal() {
      bookingModal.style.display = "flex";
      setTimeout(()=>bookingModal.querySelector('.fadeup').classList.add('visible'),20);
      document.body.style.overflow='hidden';
      bookingForm.classList.remove('hidden');
      bookingSuccess.classList.add('hidden');
      bookingError.classList.add('hidden');
      bookingForm.reset();
      selectedTime = "";
      timeSlotsDiv.innerHTML = "";
    }
    function closeBooking() {
      bookingModal.style.display = "none";
      document.body.style.overflow = '';
    }
    openBooking && (openBooking.onclick = openBookingModal);
    openBookingMain && (openBookingMain.onclick = openBookingModal);
    openBooking2 && (openBooking2.onclick = openBookingModal);
    closeBookingBtn && (closeBookingBtn.onclick = closeBooking);
    bookingModal.onclick = e => { if(e.target===bookingModal) closeBooking(); }

    // Слоты
    dateInput.addEventListener("change", renderSlots);
    function renderSlots() {
      timeSlotsDiv.innerHTML = "";
      selectedTime = "";
      const date = dateInput.value;
      if(!date) return;
      loadBookings();
      let booked = bookedTimes.filter(x=>x.date===date).map(x=>x.time);
      TIME_SLOTS.forEach(slot => {
        let btn = document.createElement("button");
        btn.className = "px-4 py-2 rounded-lg border border-[#E2D5C3] font-semibold bg-[#FAF6F1] shadow-sm hover:bg-[#F5EEE6] transition mb-1";
        btn.textContent = slot;
        btn.disabled = booked.includes(slot);
        if(btn.disabled) btn.classList.add("opacity-50", "cursor-not-allowed", "bg-[#E5D6C6]");
        btn.onclick = function() {
          [...timeSlotsDiv.children].forEach(e=>e.classList.remove('ring-2','ring-[#9B7964]'));
          this.classList.add('ring-2','ring-[#9B7964]');
          selectedTime = slot;
        }
        timeSlotsDiv.appendChild(btn);
      });
    }

    // Валидация и логика отправки записи
    bookingForm.onsubmit = function(e) {
      e.preventDefault();
      let service = serviceSelect.value.trim();
      let date = dateInput.value;
      let name = bookingForm.nameInput.value.trim();
      let phone = bookingForm.phoneInput.value.trim();
      let comment = bookingForm.commentInput.value.trim();
      // Валидация
      if(!service || !date || !selectedTime || name.length<2 || !/^[А-Яа-яA-Za-z\s\-']{2,24}$/.test(name) || !/^[\d\+\-\s\(\)]{10,20}$/.test(phone)){
        bookingError.textContent = "Пожалуйста, заполните все поля корректно и выберите время.";
        bookingError.classList.remove('hidden');
        return false;
      }
      loadBookings();
      let double = bookedTimes.some(x=>x.date===date&&x.time===selectedTime);
      if(double) {
        bookingError.textContent = "Выбранное время уже занято. Пожалуйста, выберите другой слот.";
        bookingError.classList.remove('hidden');
        renderSlots();
        return false;
      }
      bookedTimes.push({
        date, time: selectedTime, service, name, phone, comment
      });
      storeBookings();
      bookingForm.classList.add('hidden');
      bookingSuccess.classList.remove('hidden');
      setTimeout(()=>renderSlots(),300);
      return false;
    };

    // Для авто-обновления доступности слотов при частых открытиях модали
    bookingModal.addEventListener('transitionstart', ()=>renderSlots());

    // Маска телефона (очень простая)
    bookingForm.phoneInput.oninput = function() {
      this.value = this.value.replace(/[^\d\+\-\s\(\)]/g,'').substr(0,20);
    };

    // Чтобы при повторном открытии онлайн-записи всё сбрасывалось
    document.addEventListener('DOMContentLoaded', ()=>{
      loadBookings();
      renderSlots();
    });
  </script>
</body>
</html>
